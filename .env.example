# Local development uses the checked-in fallback catalogue until this is true.
WIX_CMS_ENABLED=false

# Public OAuth client identifier from Headless Settings > Headless clients.
WIX_CLIENT_ID=

# Set only after the project is linked and the CMS collections are released.
WIX_VEHICLES_COLLECTION=Vehicles
WIX_ACCESSORIES_COLLECTION=Accessories
WIX_BOOKING_COLLECTION=RentalRequests
